    <!-- PAGE HERO -->

    <main>

        <section class="page-hero">

            <div class="section-container">

                <span class="section-label">
                    ABOUT VITAL LOOP
                </span>

                <h1>
                    Connecting People.
                    <br>
                    Supporting Care.
                </h1>

                <p>
                    Vital Loop is a healthcare coordination platform
                    designed to connect emergency requirements with
                    potential blood resources, donor networks and
                    authorised hospitals through a structured journey.
                </p>

            </div>

        </section>


        <!-- MISSION -->

        <section class="quick-section">

            <div class="section-container">

                <div class="section-heading">

                    <span class="section-label">
                        OUR MISSION
                    </span>

                    <h2>
                        Making Healthcare Coordination Simpler.
                    </h2>

                    <p>
                        Vital Loop focuses on connecting people,
                        information and healthcare resources in a
                        structured and accessible way.
                    </p>

                </div>


                <div class="platform-grid">

                    <article class="platform-card">

                        <div class="platform-icon">
                            🚨
                        </div>

                        <h3>
                            Emergency Coordination
                        </h3>

                        <p>
                            Help users organise emergency blood
                            requirements and begin a structured
                            coordination journey.
                        </p>

                    </article>


                    <article class="platform-card">

                        <div class="platform-icon">
                            🩸
                        </div>

                        <h3>
                            Resource Discovery
                        </h3>

                        <p>
                            Help users discover potential nearby
                            blood resources and relevant hospitals.
                        </p>

                    </article>


                    <article class="platform-card">

                        <div class="platform-icon">
                            ✦
                        </div>

                        <h3>
                            VitaAI
                        </h3>

                        <p>
                            Provide simple navigation and
                            coordination guidance through the
                            Vital Loop experience.
                        </p>

                    </article>


                    <article class="platform-card">

                        <div class="platform-icon">
                            🏥
                        </div>

                        <h3>
                            Hospital Coordination
                        </h3>

                        <p>
                            Connect users with information about
                            authorised healthcare hospitals and
                            facilities.
                        </p>

                    </article>


                    <article class="platform-card">

                        <div class="platform-icon">
                            ✓
                        </div>

                        <h3>
                            Verification
                        </h3>

                        <p>
                            Clearly distinguish potential resource
                            information from information that has
                            been verified.
                        </p>

                    </article>


                    <article class="platform-card">

                        <div class="platform-icon">
                            📊
                        </div>

                        <h3>
                            Coordination Insights
                        </h3>

                        <p>
                            Provide structured information about
                            requests, activities and coordination
                            progress.
                        </p>

                    </article>

                </div>

            </div>

        </section>


        <!-- RESPONSIBLE USE -->

        <section class="safety-section">

            <div class="section-container">

                <div class="safety-box">

                    <div class="safety-icon">
                        🛡️
                    </div>

                    <div>

                        <span class="section-label">
                            RESPONSIBLE USE
                        </span>

                        <h2>
                            Coordination, Not Blood Distribution.
                        </h2>

                        <p>
                            Vital Loop is a coordination layer.
                            It does not store, test, transport,
                            release or distribute blood. Actual
                            collection, testing, compatibility,
                            storage, release and transfusion remain
                            with authorised blood centres and
                            healthcare professionals.
                        </p>

                    </div>

                </div>

            </div>

        </section>


